  {
   "dot": "cyan",
   "title": "One thread",
   "items": [
    "The loop runs one task at a time on one thread",
    "A task keeps control until it awaits"
   ]
  },
  {
   "dot": "orange",
   "title": "Waiting is cheap",
   "items": [
    "The selector asks the OS which sockets are ready",
    "Waiting tasks cost no CPU while they wait"
   ]
  },
  {
   "dot": "emerald",
   "title": "Rule of thumb",
   "items": [
    "Blocking calls inside a coroutine freeze every task",
    "Use await-friendly libraries or run blocking work in a thread"
   ]
  }
