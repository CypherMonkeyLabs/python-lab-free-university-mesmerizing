 "cards": [
  {
   "dot": "emerald",
   "title": "Frames",
   "items": [
    "Each call gets its own frame with its own locals",
    "Arguments are bound to parameter names, not copied"
   ]
  },
  {
   "dot": "orange",
   "title": "Results",
   "items": [
    "return hands one object back to the caller",
    "Falling off the end returns None"
   ]
  },
  {
   "dot": "rose",
   "title": "Errors",
   "items": [
    "An uncaught exception unwinds frames and builds a traceback",
    "try/except can stop the unwinding at any frame"
   ]
  }
