 "cards": [
  {
   "dot": "emerald",
   "title": "Fast path",
   "items": [
    "sys.modules is checked first, so a repeat import is a dictionary lookup",
    "Importing the same module twice runs its code once"
   ]
  },
  {
   "dot": "orange",
   "title": "Slow path",
   "items": [
    "A finder produces a ModuleSpec; a loader creates and executes the module",
    "Source files can be cached as bytecode in __pycache__"
   ]
  },
  {
   "dot": "rose",
   "title": "Why it matters",
   "items": [
    "Module-level code runs at first import only",
    "Circular imports hand back a partly built module"
   ]
  }
 ]
